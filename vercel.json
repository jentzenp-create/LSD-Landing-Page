{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/baxter-advisors",
            "destination": "/baxter-advisors/index.html"
        },
        {
            "source": "/baxter-advisors/",
            "destination": "/baxter-advisors/index.html"
        },
        {
            "source": "/baxter-advisors/(.*)",
            "destination": "/baxter-advisors/$1"
        },
        {
            "source": "/proposals/:slug",
            "destination": "/proposals/:slug/index.html"
        },
        {
            "source": "/proposals/:slug/",
            "destination": "/proposals/:slug/index.html"
        },
        {
            "source": "/proposals/:slug/(.*)",
            "destination": "/proposals/:slug/$1"
        },
        {
            "source": "/richard-rodman",
            "destination": "/proposals/rodman/index.html"
        },
        {
            "source": "/richard-rodman/",
            "destination": "/proposals/rodman/index.html"
        },
        {
            "source": "/dugan-insurance",
            "destination": "/proposals/dugan-insurance/index.html"
        },
        {
            "source": "/dugan-insurance/",
            "destination": "/proposals/dugan-insurance/index.html"
        },
        {
            "source": "/dr-leslie-k",
            "destination": "/dr-leslie-k/index.html"
        },
        {
            "source": "/dr-leslie-k/",
            "destination": "/dr-leslie-k/index.html"
        },
        {
            "source": "/dr-leslie-k/(.*)",
            "destination": "/dr-leslie-k/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/dr-leslie-k/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "no-referrer"
                }
            ]
        },
        {
            "source": "/dr-leslie-k",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "no-referrer"
                }
            ]
        }
    ]
}
